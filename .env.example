# Credenciais do Pluggy (https://dashboard.pluggy.ai)
PLUGGY_CLIENT_ID=seu_client_id
PLUGGY_CLIENT_SECRET=seu_client_secret

# IDs dos items (conexões bancárias) já criados no Pluggy, separados por vírgula.
# Também é possível adicioná-los pela tela de Configurações do app.
PLUGGY_ITEM_IDS=

# true = usa dados fictícios mesmo com credenciais configuradas
PLUGGY_DEMO=false

API_PORT=3001

# Senha para entrar no app. Obrigatória quando o servidor fica na internet (ex.: Render);
# vazia = sem login (uso só local).
APP_PASSWORD=

# Postgres gratuito (neon.tech) onde ficam os cadastros compartilhados entre PC, site e celular.
# Vazio = cada aparelho guarda só os próprios cadastros.
DATABASE_URL=
